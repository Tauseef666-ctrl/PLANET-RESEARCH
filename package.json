{
  "name": "planet-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Immersive 3D space exploration and research platform — interactive Solar System, exoplanet, asteroid, and moon databases built with React, Three.js, and TypeScript.",
  "keywords": [
    "space",
    "nasa",
    "solar-system",
    "planet",
    "three.js",
    "react",
    "typescript",
    "threejs",
    "3d",
    "data-visualization"
  ],
  "license": "MIT",
  "author": {
    "name": "Tauseef Khan",
    "url": "https://github.com/Tauseef666-ctrl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tauseef666-ctrl/PLANET-RESEARCH.git"
  },
  "homepage": "https://planet-research.vercel.app",
  "bugs": {
    "url": "https://github.com/Tauseef666-ctrl/PLANET-RESEARCH/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "fetch:satellites": "node scripts/fetch-satellites.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "framer-motion": "^11.11.0",
    "fuse.js": "^7.0.0",
    "gsap": "^3.12.5",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "three": "^0.170.0",
    "three-stdlib": "^2.33.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.0"
  }
}
